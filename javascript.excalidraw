    {
      "id": "1qNWupUwZy1K5Tg9CNZam",
      "type": "text",
      "x": 23917.670450316502,
      "y": 112.33546049938798,
      "width": 1043.8470144905207,
      "height": 272.99999999999966,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1B",
      "roundness": null,
      "seed": 2088688700,
      "version": 6259,
      "versionNonce": 1497696493,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790445501103,
      "link": null,
      "locked": false,
      "text": "But now we have a problem\n\nTwo threads can access the same memory at the same\ntime.We might expect: 12 but both read 10 before either\nwrites, so the final value can become: 11 This is called a\nrace condition. And this is why our next topic is: Atomics",
      "fontSize": 36.399999999999956,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "But now we have a problem\n\nTwo threads can access the same memory at the same time.We might expect: 12 but both read 10 before either writes, so the final value can become: 11 This is called a race condition. And this is why our next topic is: Atomics",
      "autoResize": false,
      "lineHeight": 1.25
    },
