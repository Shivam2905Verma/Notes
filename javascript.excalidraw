    {
      "id": "22lx95Mq1XMbgQVfXMM4S",
      "type": "text",
      "x": 17155.454815933103,
      "y": 2540.940129394975,
      "width": 1747.6129067285754,
      "height": 1046.4999999999986,
      "angle": 0,
