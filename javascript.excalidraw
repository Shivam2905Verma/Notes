      "lineHeight": 1.25
    },
    {
      "id": "1JhyKlnKsHNpDDAHM9O_U",
      "type": "text",
      "x": 9198.819997255177,
      "y": -3160.8200258087827,
      "width": 170.52899470898973,
      "height": 45.49999999999994,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
