      "seed": 932701116,
      "version": 5017,
      "versionNonce": 732808708,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788372529370,
      "link": null,
      "locked": false,
      "text": "When we use Arrow fuction in object",
      "fontSize": 36.399999999999956,
      "fontFamily": 5,
