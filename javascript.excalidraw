      "version": 4146,
      "versionNonce": 294721485,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790445501099,
      "link": null,
      "locked": false,
      "text": "You will still get the A C B because the synchronous loop cannot\nbe interrupted by the timer callback.",
      "fontSize": 36.399999999999956,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "You will still get the A C B because the synchronous loop cannot be interrupted by the timer callback.",
      "autoResize": false,
      "lineHeight": 1.25
    },
