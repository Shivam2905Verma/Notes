    {
      "id": "wXU6dl0mqKw7vOupToNIN",
      "type": "text",
      "x": 17154.883387361675,
      "y": 1828.0829865378325,
      "width": 1714.7557638714336,
      "height": 272.99999999999966,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
