    },
    {
      "id": "y79fIm25WM7VCBAX2MfFs",
      "type": "text",
      "x": 8458.819997255181,
      "y": -3102.248597237354,
      "width": 650.5289947089879,
      "height": 45.49999999999994,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
