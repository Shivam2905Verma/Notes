        }
      ],
      "updated": 1790445501133,
      "link": null,
      "locked": false,
      "text": "see after 0ms it goes to task queue then event loop ask there any task is waiting then check\ncondition is that call stack is empty if empty them push the callback inside the settimeout to the\nstack and execute it.\nand this also shows :- That's why 0ms does not mean \"execute after exactly 0 milliseconds.\"",
      "fontSize": 36.399999999999956,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "see after 0ms it goes to task queue then event loop ask there any task is waiting then check condition is that call stack is empty if empty them push the callback inside the settimeout to the stack and execute it.\nand this also shows :- That's why 0ms does not mean \"execute after exactly 0 milliseconds.\"",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "uHR8Wh_-h36zGxo_30gm8",
