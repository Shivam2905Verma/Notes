    {
      "id": "HqvfMc2LcgOfJXaQfdI6C",
      "type": "text",
      "x": 14396.323863552156,
      "y": -2467.2792394598987,
      "width": 1531.0414781571492,
      "height": 727.9999999999991,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
