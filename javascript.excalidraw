    {
      "id": "n1LLgT-CVfptLZWSd7kbK",
      "type": "rectangle",
      "x": 26244.837036096676,
      "y": -2419.3023962641973,
      "width": 1560.265053162671,
      "height": 101.08871368914879,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#a5d8ff",
