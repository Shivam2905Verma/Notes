    {
      "id": "mnI0WhFmtrnfRWdwrdM7w",
      "type": "text",
      "x": 17142.026244504534,
      "y": 2163.797272252118,
      "width": 1187.6129067285754,
      "height": 227.49999999999972,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0J",
      "roundness": null,
      "seed": 492859615,
      "version": 5980,
      "versionNonce": 1359179630,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "95Z3emARVaFShZ4WHQPNS",
          "type": "arrow"
        }
      ],
      "updated": 1790151502232,
      "link": null,
      "locked": false,
      "text": "ArrayBuffer itself doesn't give you normal array style access. This\ndoesn't work: buffer[0] why? Because ArrayBuffer is just the raw\nmemory container. It doesn't tell JavaScript: \"Interpret these\nbytes as integers.\"\nThat's the job of TypedArrays and DataView.",
      "fontSize": 36.399999999999956,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ArrayBuffer itself doesn't give you normal array style access. This doesn't work: buffer[0] why? Because ArrayBuffer is just the raw memory container. It doesn't tell JavaScript: \"Interpret these bytes as integers.\"\nThat's the job of TypedArrays and DataView.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "aYH84qG_703la2NlfHUMh",
      "type": "text",
      "x": 17142.026244504534,
      "y": 2423.797272252118,
      "width": 1754.2795733952426,
      "height": 90.99999999999989,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0JV",
      "roundness": null,
      "seed": 886312465,
      "version": 6128,
      "versionNonce": 827445489,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "95Z3emARVaFShZ4WHQPNS",
          "type": "arrow"
        }
      ],
      "updated": 1788689458436,
      "link": null,
      "locked": false,
      "text": "The buffer doesn't care what those bytes represent. They could represent: integers, floats, pixels,\naudio samples, network packets and etc. The same memory can be interpreted in different ways.",
      "fontSize": 36.399999999999956,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The buffer doesn't care what those bytes represent. They could represent: integers, floats, pixels, audio samples, network packets and etc. The same memory can be interpreted in different ways.",
      "autoResize": false,
      "lineHeight": 1.25
    },
