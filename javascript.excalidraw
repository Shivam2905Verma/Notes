    },
    {
      "id": "CReH5Yeo9WJribT91lIdd",
      "type": "rectangle",
      "x": 23900.12934249396,
      "y": -417.2405999217141,
      "width": 1317.2160017182068,
      "height": 89.1091484249958,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
