      "seed": 2023517810,
      "version": 7851,
      "versionNonce": 1466423090,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "95Z3emARVaFShZ4WHQPNS",
          "type": "arrow"
        }
      ],
      "updated": 1790151390880,
      "link": null,
      "locked": false,
      "text": "Constructor and super\n\nA constructor is used to initialize the state of a newly created instance.\nNow without calling the super() we cannot use this in the child class constructor because before\ninitializing the parent constrcutor we cannot initialize the child constructor so basically super() is\nused to calls the parent constructor and initialize its Attributes",
      "fontSize": 35.5947838679886,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Constructor and super\n\nA constructor is used to initialize the state of a newly created instance.\nNow without calling the super() we cannot use this in the child class constructor because before initializing the parent constrcutor we cannot initialize the child constructor so basically super() is used to calls the parent constructor and initialize its Attributes",
      "autoResize": false,
      "lineHeight": 1.25
    },
