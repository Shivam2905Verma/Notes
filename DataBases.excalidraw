      "frameId": null,
      "index": "b0ZMl",
      "roundness": null,
      "seed": 1674477631,
      "version": 5762,
      "versionNonce": 600207743,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "ZVeCIocNGPAU8MCgZP9a6",
          "type": "arrow"
        }
      ],
      "updated": 1794678287388,
      "link": null,
      "locked": false,
      "text": "Now we are telling SQL: \"Divide the rows into separate windows based on region, and calculate the sum inside each window.\" So East employees get the East\ntotal, West employees get the West total, and so on.",
      "fontSize": 22.707930367504815,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now we are telling SQL: \"Divide the rows into separate windows based on region, and calculate the sum inside each window.\" So East employees get the East total, West employees get the West total, and so on.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "gKlH8i7CxDCmp19CEjMQL",
      "type": "text",
      "x": 928.1469434038845,
      "y": 8357.06794989156,
      "width": 2001.0403587021153,
      "height": 56.76982591876204,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0ZMt",
      "roundness": null,
      "seed": 536523473,
      "version": 5759,
      "versionNonce": 169470367,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "ZVeCIocNGPAU8MCgZP9a6",
          "type": "arrow"
        }
      ],
      "updated": 1794678287388,
      "link": null,
      "locked": false,
      "text": "Now we are telling SQL: \"Divide rows by region, arrange them by amount, and calculate the sum using the window frame up to the current row.\" This gives\nus a running total.",
      "fontSize": 22.707930367504815,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now we are telling SQL: \"Divide rows by region, arrange them by amount, and calculate the sum using the window frame up to the current row.\" This gives us a running total.",
      "autoResize": false,
      "lineHeight": 1.25
    },
